{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "WebWorker"],
    "jsx": "preserve",
    "jsxImportSource": "masonkit-octane",
    "sourceMap": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "masonkit-octane/jsx-runtime": ["./types/jsx-runtime.d.ts"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true
  },
  "include": ["src", "types"],
  "exclude": ["node_modules", "platforms"]
}
